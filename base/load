#!/bin/bash
##############################################
# Verificação de créditos e criação do tempo
##############################################





CONTADOR="/userdata/system/.dev/contador.txt"
TEMPO_FILE="/userdata/system/.dev/tempo_jogo.txt"

# Verifica se o arquivo contador existe
if [ -f "$CONTADOR" ]; then
    count=$(cat "$CONTADOR")

    if [ "$count" -le 0 ]; then
        echo "Sem créditos disponíveis. O jogo não será iniciado."
        exit 0
    fi
else
    echo "Arquivo $CONTADOR não encontrado!"
    exit 1
fi

#########################
#########################
#########################


#########################
#########################
#########################


echo "" >> /userdata/system/.dev/coin

cp -f /userdata/system/configs/retroarch/retroarchcustom.cfg /userdata/system/configs/retroarch/retroarch.cfg
sed -i 's/^input_driver *= *udev/input_driver = "x"/'  /userdata/system/configs/retroarch/retroarch.cfg
######
# Captura o nome da pasta do jogo (ex: "mame" de "roms/mame/tektagt.zip")
rom_dir=$(basename "$(dirname "$1")")

# Caminho do arquivo de configuração do RetroArch
cfg_file="/userdata/system/configs/retroarch/retroarch.cfg"

# Novo caminho que será gravado
save_path="/userdata/saves/$rom_dir"

# Faz backup do arquivo antes de alterar (opcional, mas seguro)
cp "$cfg_file" "$cfg_file.bak"

# Atualiza ou insere as linhas desejadas no arquivo de configuração
sed -i \
  -e "s|^savestate_directory = .*|savestate_directory = \"$save_path\"|" \
  -e "s|^savefile_directory = .*|savefile_directory = \"$save_path\"|" \
  "$cfg_file"

#########################!!!!!!!!!!!!!!!!!!!!!!!!!
# Garante que o arquivo exista
[ -f "$cfg_file" ] || { echo "Arquivo $cfg_file não encontrado!"; exit 1; }

# -----------------------------------------------------------------------------
# savestate_auto_save / savestate_auto_load
# -----------------------------------------------------------------------------
if grep -q '^savestate_auto_save' "$cfg_file"; then
  sed -i 's|^savestate_auto_save = .*|savestate_auto_save = false|' "$cfg_file"
else
  sed -i '/^config_save_on_exit = "false"/a savestate_auto_save = false' "$cfg_file"
fi

if grep -q '^savestate_auto_load' "$cfg_file"; then
  sed -i 's|^savestate_auto_load = .*|savestate_auto_load = true|' "$cfg_file"
else
  sed -i '/^config_save_on_exit = "false"/a savestate_auto_load = true' "$cfg_file"
fi

# -----------------------------------------------------------------------------
# input_enable_hotkey_btn / input_enable_hotkey
# -----------------------------------------------------------------------------
if grep -q '^input_enable_hotkey_btn' "$cfg_file"; then
  sed -i 's|^input_enable_hotkey_btn = .*|input_enable_hotkey_btn = "8"|' "$cfg_file"
else
  sed -i '/^config_save_on_exit = "false"/a input_enable_hotkey_btn = "nul"' "$cfg_file"
fi

if grep -q '^input_enable_hotkey' "$cfg_file"; then
  sed -i 's|^input_enable_hotkey = .*|input_enable_hotkey = "nul"|' "$cfg_file"
else
  sed -i '/^config_save_on_exit = "false"/a input_enable_hotkey = "nul"' "$cfg_file"
fi

# -----------------------------------------------------------------------------
# Desativar notificações do RetroArch
# -----------------------------------------------------------------------------
disable_notifications=(
  'notification_show_autoconfig = "false"'
  'notification_show_cheats_applied = "false"'
  'notification_show_patch_applied = "false"'
  'notification_show_remap_load = "false"'
  'notification_show_screenshot = "false"'
  'notification_show_state = "false"'
  'notification_show_config_override_load = "false"'
  'notification_show_save_state = "false"'
  'notification_show_load_state = "false"'
  'notification_show_fast_forward = "false"'
  'notification_show_settings_load = "false"'
  'notification_show_netplay = "false"'
)

for opt in "${disable_notifications[@]}"; do
  key=$(echo "$opt" | cut -d'=' -f1 | xargs)
  if grep -q "^$key" "$cfg_file"; then
    sed -i "s|^$key.*|$opt|" "$cfg_file"
  else
    sed -i "/^config_save_on_exit =/a $opt" "$cfg_file"
  fi
done

# -----------------------------------------------------------------------------
# video_font_enable
# -----------------------------------------------------------------------------
if grep -q '^video_font_enable' "$cfg_file"; then
  sed -i 's|^video_font_enable = .*|video_font_enable = "false"|' "$cfg_file"
else
  sed -i '/^config_save_on_exit = "false"/a video_font_enable = "false"' "$cfg_file"
fi

echo "Configurações aplicadas com sucesso no $cfg_file!"

######



