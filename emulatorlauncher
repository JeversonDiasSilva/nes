#!/bin/bash

cp -f /userdata/system/.dev/es_input.cfg /userdata/system/configs/emulationstation/

SAVE_ROOT="/userdata/saves"
find "$SAVE_ROOT" -type f -regex '.*\.state[0-9]$' | while read -r file; do
    dir=$(dirname "$file")
    base=$(basename "$file")
    game="${base%%.state*}"

    saves=( $(ls -1t "$dir"/"$game".state[0-9] 2>/dev/null) )
    [[ ${#saves[@]} -eq 0 ]] && continue

    newest="${saves[0]}"
    auto_file="$dir/$game.state.auto"

    if [[ -f "$auto_file" ]]; then
        if [[ "$newest" -nt "$auto_file" ]]; then
            mv -f "$newest" "$auto_file"
        else
            newest="$auto_file"
        fi
    else
        mv -f "$newest" "$auto_file"
    fi

    for old in "${saves[@]}"; do
        [[ "$old" != "$newest" ]] && rm -f "$old"
    done
done

rm -f /userdata/system/configs/retroarch/retroarchcustom.cfg

####################################################################
# 1. VERIFICAÇÃO DE SALDO
####################################################################

if [ ! -f /userdata/system/.dev/contador.txt ]; then
    echo "contador.txt não encontrado. Bloqueando."
    exit 1
fi

count=$(cat /userdata/system/.dev/contador.txt)
if [ "$count" -le 0 ]; then
    echo "Saldo zerado."
    Launcher_off.sh
    mpv /userdata/system/.dev/efeitos_sonoros/insert_coin.wav
    exit 0
fi

####################################################################
# 2. SISTEMAS ARCADE (SEM TEMPO)
####################################################################

if [[ "$@" == *"atomiswave"* ]] || \
   [[ "$@" == *"fbalpha"* ]] || \
   [[ "$@" == *"fbneo"* ]] || \
   [[ "$@" == *"mame"* ]] || \
   [[ "$@" == *"naomi"* ]] || \
   [[ "$@" == *"teknoparrot"* ]]; then

    echo "Arcade detectado (modo ficha)."

    echo "" > /userdata/system/.dev/coin
    /usr/lib/python3.11/site-packages/configgen/emulatorlauncher.py "$@"
    Launcher_off.sh
    rm -f /userdata/system/.dev/coin
    exit 0
fi

####################################################################
# 3. CONSOLES (MODO TEMPO – SEGUNDOS RESTANTES)
####################################################################

echo "Console detectado. Descontando 1 crédito."
count=$((count - 1))
echo "$count" > /userdata/system/.dev/contador.txt

CAMINHO_COIN="/usr/bin/one"

if [ -f "$CAMINHO_COIN" ]; then
    TEMPO_JOGO_MINUTOS=$(grep -oP 'TEMPO_JOGO_MINUTOS\s*=\s*\K\d+' "$CAMINHO_COIN")
fi

TEMPO_JOGO_MINUTOS=${TEMPO_JOGO_MINUTOS:-15}
TEMPO_JOGO_SEGUNDOS=$((TEMPO_JOGO_MINUTOS * 60))

echo "Tempo configurado: $TEMPO_JOGO_MINUTOS minutos"
echo "$TEMPO_JOGO_SEGUNDOS" > /userdata/system/.dev/tempo_jogo.txt

####################################################################
# INICIA JOGO E OVERLAY
####################################################################

/usr/lib/python3.11/site-packages/configgen/emulatorlauncher.py "$@" &
game_pid=$!

python3.14 /usr/bin/two &

####################################################################
# FUNÇÕES DE CONTROLE
####################################################################

kill_emulador() {
    xdotool key alt+F4
}

####################################################################
# CONTADOR DE TEMPO (CORRIGIDO, SEM BUG)
####################################################################

decrementa_tempo_jogo() {
    local file_path="/userdata/system/.dev/tempo_jogo.txt"
    local tempo_atual

    sleep 1

    while true; do
        [ ! -f "$file_path" ] && break

        tempo_atual=$(cat "$file_path" 2>/dev/null)

        if ! [[ "$tempo_atual" =~ ^[0-9]+$ ]]; then
            sleep 1
            continue
        fi

        if [ "$tempo_atual" -le 0 ]; then
            echo "Tempo esgotado."
            kill_emulador
            rm -f "$file_path"
            break
        fi

        tempo_atual=$((tempo_atual - 1))

        # ESCRITA ATÔMICA (CORREÇÃO CRÍTICA)
        echo "$tempo_atual" > "$file_path.tmp" && mv "$file_path.tmp" "$file_path"

        sleep 1
    done
}

# Garante apenas um contador
pkill -f decrementa_tempo_jogo 2>/dev/null
decrementa_tempo_jogo &

####################################################################
# AGUARDA FECHAMENTO DO JOGO
####################################################################

wait $game_pid

Launcher_off.sh
exit 0
